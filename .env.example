DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# For local setup, omit DB_HOST and Django uses SQLite (development only).
# For PostgreSQL, set DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT.
DB_HOST=db
DB_NAME=autorent
DB_USER=autorent
DB_PASSWORD=change_this_password
DB_PORT=5432
